DATABASE_URL=postgresql+psycopg://tcga:tcga@postgres:5432/tcga_explorer
APP_RELEASE_COMMIT=development
APP_RELEASE_REF=development
TCGA_DATA_DIR=/data/tcga
TCGA_CDR_PATH=/app/clinical/TCGA-CDR-SupplementalTableS1.xlsx
CANCER_REPOSITORY_DIR=/data/cancer_repository
CANCER_REPOSITORY_REGISTRY_DIR=/app/repository_registry
# Production: /mnt/data2/tcga_trace_repository
CANCER_REPOSITORY_HOST_DIR=./external_repository
CANCER_REPOSITORY_STAGING_HOST_DIR=./external_repository_staging
JCGA_DATA_DIR=/app/jcga
ARTIFACT_DIR=/app/artifacts
COMPUTE_MULTIVERSE_HOURLY_LIMIT=1
COMPUTE_SESSION_HOURLY_LIMIT=5
PUBLIC_MULTIVERSE_MAX_ANALYSES=72
DERIVED_EXPRESSION_DIR=/app/derived/rna_bulk
R_SCRIPT_PATH=/app/scripts/km_analysis.R
CORS_ORIGINS=*
BOOTSTRAP_ON_STARTUP=true
PRELOAD_CACHE_ON_STARTUP=true
PRELOAD_CACHE_STRICT=true
PRELOAD_GDC_EXPRESSION_MATRICES_ON_STARTUP=true

# Public API and remote MCP.
PUBLIC_BASE_URL=https://apps.cienciavida.org/tcga_explorer
PUBLIC_PATH_PREFIX=/tcga_explorer
PUBLIC_API_ENABLED=true
ATTESTATION_ENABLED=true
ATTESTATION_AUTO_GENERATE=true
ATTESTATION_PRIVATE_KEY_PATH=/run/attestation/ed25519-private.pem
# Optional override; defaults to PUBLIC_BASE_URL when empty.
ATTESTATION_ISSUER=
COMPUTE_GLOBAL_CONCURRENCY=2
COMPUTE_QUEUE_MAX_SIZE=50
COMPUTE_MAX_ACTIVE_PER_CLIENT=5
COMPUTE_SINGLE_HOURLY_LIMIT=10
COMPUTE_BATCH_HOURLY_LIMIT=2
COMPUTE_PANCANCER_HOURLY_LIMIT=2
COMPUTE_STALE_SECONDS=1800
COMPUTE_MAX_ATTEMPTS=2
PUBLIC_BATCH_MAX_ANALYSES=25
ARTIFACT_RETENTION_DAYS=90
MCP_ALLOWED_HOSTS=apps.cienciavida.org,apps.cienciavida.org:*,localhost,localhost:*,127.0.0.1,127.0.0.1:*,testserver
MCP_ALLOWED_ORIGINS=https://apps.cienciavida.org,https://chatgpt.com,https://chat.openai.com,https://claude.ai,http://localhost:3000,http://localhost:5173

# Public reverse-proxy path used by the production build.
VITE_BASE_PATH=/tcga_explorer/
VITE_API_BASE_URL=/tcga_explorer

# Apache is expected to proxy /tcga_explorer/ to this host port.
TCGA_EXPLORER_HTTP_BIND=127.0.0.1
TCGA_EXPLORER_HTTP_PORT=3000
