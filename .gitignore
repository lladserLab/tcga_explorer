.DS_Store

# Local environment
.env
.env.*
!.env.example

# Python
__pycache__/
*.py[cod]
.pytest_cache/
.venv/
venv/

# Node / Vite
frontend/node_modules/
frontend/dist/

# Docker / local runtime state
postgres_data/
logs/
*.log

# Generated analysis outputs and local data caches
artifacts/*
!artifacts/.gitkeep
derived/*
!derived/.gitkeep
clinical/*
!clinical/.gitkeep
jcga/*
!jcga/.gitkeep
external_repository/*
!external_repository/.gitkeep
external_repository_staging/*
!external_repository_staging/.gitkeep

# Generated manuscript outputs
manuscript/bioinformatics_app_note/build/

# Local point-in-time backups are retained on the workstation, not in Git.
release_backups/

# Filled owner metadata may include private reviewer URLs or contact details.
manuscript/bioinformatics_app_note/submission/owner_metadata*.json
!manuscript/bioinformatics_app_note/submission/owner_metadata.template.json
