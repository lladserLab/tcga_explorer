ARG VERIFY_BASE=ubuntu:24.04@sha256:534baea6a22c03a63003dbc8dbe78fe34bc0d7e595d9a9dc9834884ff530eb55
FROM ${VERIFY_BASE}
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates xvfb xauth libgtk-3-0 libnss3 libgbm1 libasound2t64 libatk-bridge2.0-0 libdrm2 libxss1 dbus-x11 && rm -rf /var/lib/apt/lists/*
# Deliberately no R, Python, Node, compiler or Docker client.
CMD ["/bin/bash"]
