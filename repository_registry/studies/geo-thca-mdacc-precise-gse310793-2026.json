    "cancer_code": "THCA",
    "name": "MDACC PRECISE papillary thyroid cohort subset (GSE310793)",
    "description": "Independent papillary thyroid carcinoma cohort with bulk RNA sequencing and individually published progression-free survival for an explicitly linked eleven-patient subset.",
    "cohort_context": "The MD Anderson discovery cohort contains 109 primary papillary thyroid carcinomas collected at surgery between 1993 and 2012. The PRECISE supplement publicly reports exact PFS for eleven tumors selected for single-nucleus profiling. GEO sample descriptions provide the deterministic Sample N to bulk-library mapping used here; the other 98 bulk profiles are excluded because their individual endpoint records are not public.",
    "source_provider": "geo",
    "source_accession": "GSE310793",
    "source_url": "https://www.ncbi.nlm.nih.gov/geo/query/acc.cgi?acc=GSE310793",
    "publication_citation": "Li et al. Clinical Cancer Research 2026",
    "publication_id": "PMID:42008746; PMCID:PMC13264843; DOI:10.1158/1078-0432.CCR-25-4488",
    "organism": "Homo sapiens",
    "assay": "bulk_rna_seq",
    "independence_status": "verified_external",
    "license_id": "LicenseRef-NCBI-GEO-Data-Use-and-PMC-Fair-Use",
    "license_url": "https://www.ncbi.nlm.nih.gov/geo/info/disclaimer.html",
    "redistribution_allowed": false,
    "metadata": {
      "source_program": "MD Anderson PRECISE papillary thyroid carcinoma discovery cohort",
      "source_data_system": "NCBI Gene Expression Omnibus plus the PubMed Central author-manuscript supplement",
      "source_platform": "Illumina NovaSeq 6000",
      "library_method": "Poly(A)-selected bulk RNA-seq from untreated primary surgical-resection tumors",
      "endpoint_context": "Progression-free survival from papillary thyroid carcinoma diagnosis",
      "redistribution_note": "TRACE Explorer analyzes the public GEO matrix and a curated transcription of eleven endpoint rows from the public supplement. Raw matrix and supplement redistribution are disabled; source copyright and fair-use terms remain controlling.",
      "curation_note": "The public supplement contains eleven tumor records with exact PFS status and duration: six events and five censored observations. GEO SOFT does not place outcomes in sample characteristics, but each bulk sample explicitly records a Library name: Sample N description. TRACE Explorer requires that exact description-to-record match and rejects positional inference. Although the full cohort contains 109 bulk profiles, only the eleven endpoint-linked profiles are exposed for survival analysis."
    }
  },
