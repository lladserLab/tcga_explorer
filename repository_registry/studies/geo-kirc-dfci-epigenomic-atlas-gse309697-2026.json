  "dataset": {
    "id": "geo-kirc-dfci-epigenomic-atlas-gse309697-2026",
    "cancer_code": "KIRC",
    "name": "Dana-Farber ccRCC epigenomic-atlas RNA cohort (GSE309697)",
    "description": "Independent clear-cell renal-cell carcinoma cohort with bulk tumor RNA sequencing and individual overall survival from diagnosis.",
    "cohort_context": "The source atlas profiled normal kidney, localized clear-cell renal-cell carcinoma and metastases from 32 patients across several genomic assays. TRACE Explorer selects one bulk RNA profile for 23 patients, preferring a local tumor when available and otherwise retaining one source-listed metastasis. One patient with a non-positive diagnosis-to-follow-up interval is removed, leaving 22 endpoint-complete patients.",
    "source_provider": "geo",
    "source_accession": "GSE309697",
    "source_url": "https://www.ncbi.nlm.nih.gov/geo/query/acc.cgi?acc=GSE309697",
    "publication_citation": "Abou Alaiwi et al. Cell Reports 2026",
    "publication_id": "PMID:41689799; PMCID:PMC13282931; DOI:10.1016/j.celrep.2026.116968",
    "organism": "Homo sapiens",
    "assay": "bulk_rna_seq",
    "independence_status": "verified_external",
    "license_id": "LicenseRef-NCBI-GEO-Data-Use-and-CC-BY-NC-ND-4.0",
    "license_url": "https://www.ncbi.nlm.nih.gov/geo/info/disclaimer.html",
    "redistribution_allowed": false,
    "metadata": {
      "source_program": "Dana-Farber Cancer Institute ccRCC epigenomic atlas",
      "source_data_system": "NCBI Gene Expression Omnibus and Europe PMC",
      "source_platform": "Illumina HiSeq 2000",
      "library_method": "Poly(A)-selected bulk RNA sequencing quantified at gene level with Cufflinks; source FPKM values are transformed to log2(FPKM + 1) by TRACE Explorer.",
      "endpoint_context": "Overall survival from RCC diagnosis, reconstructed from age at diagnosis and age at death or last follow-up in Supplementary Table S1C",
      "endpoint_caveat": "The diagnosis-to-follow-up interval is reconstructed as an age difference and can contain rounding error. The cohort mixes localized tumors and metastases, spans treatment histories and is not an untreated natural-history cohort.",
      "sample_selection_note": "One RNA profile is retained per linked patient. A local-tumor profile is preferred when its title and filename identify one; otherwise the first source-listed metastasis is retained. Patient 1247 has two metastatic RNA profiles and GSM9277313 is selected deterministically. Patient 12 is omitted because the clinical key RCCT 1284/1308/1077 and RNA title key 1077/1284/1308 cannot be reconciled without manual reinterpretation.",
      "source_metadata_caveat": "For Patient 962, GEO title and filename identify GSM9277292 as the local tumor and Supplementary Table S1A confirms that a local-tumor RNA profile exists, while the GEO tissue characteristic is shifted relative to the assay title. Selection therefore uses the explicit RNA title and filename, and this source inconsistency remains visible in the audit metadata.",
      "endpoint_exclusion_note": "Patient 14 (RCCT 1166) has age at death or last follow-up lower than age at RCC diagnosis. Its derived interval is blanked by the prespecified positive-time rule and the patient is excluded before expression analysis.",
      "expression_processing_note": "The 23 source Cufflinks files contain the same multiset of 20,165 gene-symbol rows in different row orders. TRACE Explorer aligns rows by case-insensitive symbol, excludes all 109 rows belonging to 52 ambiguous symbols and retains 20,056 unique symbols without aggregation.",
      "overlap_note": "The Dana-Farber atlas is external to TCGA-KIRC and is not pooled with the existing CheckMate, RECA-EU, CPTAC, IMmotion150 or FUSCC kidney cohorts.",
      "redistribution_note": "TRACE Explorer downloads and transforms the pinned public files in place. Matrix redistribution is disabled; NCBI GEO terms and the article's CC BY-NC-ND 4.0 license remain controlling."
    }
  },
