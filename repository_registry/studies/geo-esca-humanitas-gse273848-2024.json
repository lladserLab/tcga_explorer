    "organism": "Homo sapiens",
    "assay": "bulk_rna_seq",
    "independence_status": "verified_external",
    "license_id": "LicenseRef-NCBI-GEO-Data-Use-and-CC-BY-4.0",
    "license_url": "https://www.ncbi.nlm.nih.gov/geo/info/disclaimer.html",
    "redistribution_allowed": false,
    "metadata": {
      "source_program": "Humanitas Research Hospital esophageal adenocarcinoma cohort",
      "source_data_system": "NCBI Gene Expression Omnibus plus the open-access article supplement",
      "source_platform": "Illumina NextSeq 550",
      "library_method": "SMARTer Stranded Total RNA libraries, paired-end sequencing, STAR GRCh38 alignment and featureCounts with GENCODE release 38 gene symbols",
      "endpoint_context": "Postoperative disease-free survival after esophageal adenocarcinoma resection",
      "redistribution_note": "TRACE Explorer analyzes the public GEO count matrix and a curated transcription of endpoint rows from the CC BY 4.0 article supplement. Raw matrix redistribution is disabled and the source terms remain controlling.",
      "curation_note": "Supplementary Table S1 reports follow-up in months and postoperative relapse or progression. Figure 4B explicitly labels the local analysis as disease-free survival, and its event steps occur at the published follow-up months of the relapse/progression records. Event-free patients are censored at their reported follow-up. Patient_07 and Patient_10 are excluded because the table does not report a postoperative event status.",
      "clinical_covariate_note": "Histologic grade and sex are exposed as analysis covariates. The reported pathologic TNM string is retained in each source metadata record but is not represented as an ordinal stage group because the supplement does not publish an AJCC stage-group field.",
      "source_matrix_note": "The frozen GEO matrix has a malformed final non-tumor column labelled Patient_22_NT whose value is constant across genes. It is not selected or used: all retained samples are tumor columns with direct title-to-patient linkage."
    }
  },
