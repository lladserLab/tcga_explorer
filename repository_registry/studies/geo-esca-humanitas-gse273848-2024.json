    "name": "Humanitas esophageal adenocarcinoma cohort (GSE273848)",
    "description": "Independent esophageal adenocarcinoma cohort with direct bulk total RNA sequencing and individually published postoperative disease-free survival.",
    "cohort_context": "The source study profiled tumor and matched non-tumor esophageal tissues. TRACE Explorer retains one primary tumor profile for each of the twenty patients with an unambiguous postoperative relapse/progression status and follow-up time. Two tumor profiles without a reported postoperative endpoint are excluded.",
    "source_provider": "geo",
    "source_accession": "GSE273848",
    "source_url": "https://www.ncbi.nlm.nih.gov/geo/query/acc.cgi?acc=GSE273848",
    "publication_citation": "Lambroia et al. Cancers 2024",
