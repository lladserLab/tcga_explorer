{
  "schema_version": "tcga-trace-study-spec-v1",
  "dataset": {
    "id": "cbioportal-prad-dkfz-2018",
    "cancer_code": "PRAD",
    "name": "Early-onset localized prostate cancer (DKFZ/ICGC, 2018)",
    "description": "Independent early-onset localized prostate cancer cohort with primary-tumor bulk RNA-seq and biochemical recurrence follow-up after radical prostatectomy.",
    "cohort_context": "Early-onset localized prostate cancer treated with radical prostatectomy; a recurrence-validation context distinct from metastatic SU2C and from TCGA-PRAD.",
    "source_provider": "cbioportal_datahub",
    "source_accession": "prostate_dkfz_2018",
    "source_url": "https://github.com/cBioPortal/datahub/tree/master/public/prostate_dkfz_2018",
    "publication_citation": "Gerhauser et al. Cancer Cell 2018",
    "publication_id": "PMID:30537516; DOI:10.1016/j.ccell.2018.10.016",
    "organism": "Homo sapiens",
    "assay": "bulk_rna_seq",
    "independence_status": "verified_external",
    "license_id": "ODbL-1.0",
    "license_url": "https://opendatacommons.org/licenses/odbl/1-0/",
    "redistribution_allowed": true,
    "metadata": {
      "study_design": "Early-onset prostate cancer radical-prostatectomy cohort",
      "endpoint_context": "Biochemical recurrence-free survival",
      "curation_note": "The RNA profile contains multiple localized tumor foci for some participants. TRACE Explorer retains one profile per participant with its deterministic sample-selection rule."
    }
  },
  "source": {
    "repository": "cBioPortal/datahub",
    "branch": "master",
    "study_path": "public/prostate_dkfz_2018",
    "files": {
      "expression": "data_mrna_seq_rpkm.txt",
      "patients": "data_clinical_patient.txt",
      "samples": "data_clinical_sample.txt",
      "study_metadata": "meta_study.txt",
      "expression_metadata": "meta_mrna_seq_rpkm.txt",
      "license": {
        "path": "README.md",
        "scope": "repository",
        "target_name": "DATAHUB_LICENSE_README.md"
      }
    }
  },
  "samples": {
    "sample_type_column": "SAMPLE_CLASS",
    "sample_type_default": "Localized prostate tumor",
    "sample_role": "Localized primary prostate tumor used for bulk RNA sequencing",
    "eligibility_rules": [
      {
        "field": "sample.ONCOTREE_CODE",
        "include": ["PROSTATE"],
        "required": true
      },
      {
        "field": "sample.SAMPLE_CLASS",
        "include": ["Tumor"],
        "required": true
      },
      {
        "field": "sample.LOCALIZED_TUMOR",
        "include": ["TRUE"],
        "required": true
      }
    ],
    "selection_rank": 0,
    "stage_fields": ["patient.STAGE"],
    "grade_fields": ["sample.GLEASON_SCORE"],
    "gender_fields": ["patient.SEX"],
    "age_fields": ["patient.AGE"]
  },
  "expression": {
    "layer_id": "log2_rpkm",
    "label": "log2(RPKM + 1)",
    "source_unit": "RPKM",
    "transform": "log2p",
    "analysis_unit": "log2(RPKM + 1)",
    "feature_id_type": "hugo_symbol",
    "mapping_source": "cBioPortal Genes API",
    "duplicate_feature_policy": "mean_within_source_id",
    "duplicate_feature_rationale": "Repeated rows with the same supplied symbol are averaged sample-wise before log2(RPKM + 1); different identifiers are never merged implicitly.",
    "scale_note": "The DataHub molecular-profile metadata identifies the frozen source values as RNA-seq RPKM. TRACE Explorer applies log2(RPKM + 1) once."
  },
  "endpoints": [
    {
      "endpoint_id": "BCRFS",
      "standard_code": "BCRFS",
      "label": "Biochemical recurrence-free survival",
      "time_column": "TIME_FROM_SURGERY_TO_BCR_LASTFU",
      "event_column": "BCR_STATUS",
      "time_unit": "months",
      "time_origin": "Radical prostatectomy",
      "event_definition": "Biochemical recurrence after radical prostatectomy",
      "censor_prefix": "0",
      "event_prefix": "1"
    }
  ]
}
